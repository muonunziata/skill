# ───────────────────────────── API keys ─────────────────────────────
GEMINI_API_KEY=
# Only required if REDACCTOR_MODEL is a Claude model (claude-*)
ANTHROPIC_API_KEY=
# Only required if REDACCTOR_MODEL is an OpenAI model (gpt-*, o1, o3, o4…)
OPENAI_API_KEY=

# ───────────────────────────── WordPress ────────────────────────────
# Site URL or REST root. All of these work:
#   https://your-site.com      https://your-site.com/wp-json
WP_REST_URL=https://your-site.com/wp-json
# Application Password:  username:xxxx xxxx xxxx xxxx xxxx xxxx   (WP Admin → Users → Profile → Application Passwords)
# …or a Bearer/JWT token (any value without a colon is sent as "Authorization: Bearer <token>").
WP_AUTH_TOKEN=

# ───────────────────────────── Models ───────────────────────────────
# Agent 1 – Rastreador (must be a Gemini model: it uses Google Search grounding)
RASTREADOR_MODEL=gemini-1.5-flash
# Agent 2 – Redactor (easy to swap: gemini-*, claude-*, gpt-*)
#   REDACCTOR_MODEL=gemini-1.5-flash   |   claude-3-5-haiku-latest   |   gpt-4o-mini
REDACCTOR_MODEL=gemini-1.5-flash
# Agent 3 – Auditor (Gemini)
AUDITOR_MODEL=gemini-1.5-flash
# NOTE: Google has retired the Gemini 1.5 family on the public API. If `check` reports the model is not
# available, set the three variables above to a current model, e.g. gemini-2.5-flash.

# ──────────────── AI featured image (optional, Agent 2) ────────────────
# Leave IMAGE_API_KEY empty to disable. Providers:
#   replicate → Flux & friends.  IMAGE_API_ENDPOINT default: https://api.replicate.com/v1/models/{model}/predictions
#   gemini    → "Nano Banana" (Gemini image models); uses IMAGE_API_KEY, or GEMINI_API_KEY if empty
#   openai    → any OpenAI-compatible /images/generations endpoint (OpenAI, Together, fal proxies, …)
IMAGE_PROVIDER=replicate
IMAGE_API_KEY=
IMAGE_API_ENDPOINT=
#   replicate: black-forest-labs/flux-1.1-pro | black-forest-labs/flux-schnell
#   gemini:    gemini-2.5-flash-image
#   openai:    gpt-image-1 | dall-e-3 | black-forest-labs/FLUX.1-schnell (Together)
IMAGE_MODEL=black-forest-labs/flux-1.1-pro
IMAGE_ASPECT_RATIO=16:9
# Extra provider-specific parameters as JSON, merged into the request (e.g. {"output_quality": 90})
IMAGE_EXTRA_INPUT=
# Add an "AI-generated illustration" credit to the image caption. Strongly recommended.
AI_IMAGE_LABEL=true

# ──────────────── Extra news source (optional): Mediastack ────────────────
# https://mediastack.com/signup · plans: https://mediastack.com/pricing · notes: docs/RECURSOS.md
# The free plan is 100 requests/month; the agents throttle themselves to stay within it.
MEDIASTACK_API_KEY=
MEDIASTACK_MIN_HOURS=8
MEDIASTACK_MONTHLY_LIMIT=100
MEDIASTACK_COUNTRIES=us
MEDIASTACK_LANGUAGES=en,es
MEDIASTACK_LIMIT=25
# auto = try HTTPS, fall back to HTTP (with a warning) if the plan does not allow HTTPS; true / false to force
MEDIASTACK_HTTPS=auto

# ──────────── Agent 4 · Social Designer (Instagram / TikTok carousels + video) ────────────
# Runs after an article is approved and sent to WordPress. Slides are drawn on the GoLehighAcres.org brand.
# Needs Chromium (`python -m playwright install chromium`) and ffmpeg (installed with imageio-ffmpeg).
SOCIAL_ENABLED=true
SOCIAL_FORMATS=instagram,tiktok
SOCIAL_VIDEO=true
# Model that writes the slides/captions (default: the Redactor's model)
SOCIAL_MODEL=
SOCIAL_MAX_SLIDES=8
SOCIAL_VIDEO_SECONDS=30
# light (default, white + brand green) | dark | brand (solid green)
SOCIAL_THEME=light
# Upload the kit to the WordPress media library and show it on the post's review screen
SOCIAL_UPLOAD=true
# Optional narration for the video: none | gemini | openai (uses GEMINI_API_KEY / OPENAI_API_KEY)
SOCIAL_VOICE=none
SOCIAL_VOICE_MODEL=
# Optional: notify Make / Zapier / n8n when a kit is ready (JSON POST, signed with X-Lehigh-Signature: sha256=HMAC)
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_SECRET=
# Path to Chrome/Chromium if Playwright's own browser is not installed
CHROMIUM_PATH=

# ──────────── Brand (defaults are the official GoLehighAcres.org logos and colours) ────────────
BRAND_NAME=GoLehighAcres.org
BRAND_HANDLE=GoLehighAcres.org
BRAND_COLOR=#1b6a55
BRAND_ACCENT=#ff5757
BRAND_DARK=#0f3a30
# Leave empty to use the packaged official logos (agents/lehigh_agents/social/assets)
BRAND_LOGO=
BRAND_LOGO_VERTICAL=
BRAND_FONT=Poppins

# ───────────────────────────── Behaviour ────────────────────────────
SEARCH_TOPIC=Lehigh Acres, Florida
SEARCH_FOCUS=desarrollo urbano,bienes raíces,infraestructura,comunidad
ARTICLE_LANGUAGE=es
MAX_ITEMS_PER_RUN=3
FRESHNESS_DAYS=14
# Auditor: minimum score (0-100) for "approved"
AUDIT_MIN_SCORE=80
# If the Auditor flags an article, the Redactor gets this many chances to fix it before it is discarded/flagged
MAX_REVISIONS=1
# Also send flagged articles to WordPress, as "pending review" (default: only approved ones are sent, as drafts)
POST_FLAGGED=false
# Allow the source page's own (copyrighted) image as featured image. Default: only openly licensed images.
ALLOW_SOURCE_IMAGES=false
# `watch` mode
LOOP_INTERVAL_MINUTES=60
STATE_DIR=./state
LOG_LEVEL=INFO
