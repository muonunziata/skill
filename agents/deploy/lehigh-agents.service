# systemd unit: copy to /etc/systemd/system/, adjust the paths and user, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now lehigh-agents
[Unit]
Description=Lehigh News Hub agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agents
WorkingDirectory=/opt/lehigh-news-hub/agents
EnvironmentFile=/opt/lehigh-news-hub/agents/.env
ExecStart=/opt/lehigh-news-hub/agents/.venv/bin/python main.py watch
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/lehigh-news-hub/agents/state

[Install]
WantedBy=multi-user.target
